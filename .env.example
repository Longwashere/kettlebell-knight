# Copy to .env.production.local (git-ignored) and fill in before `npm run build` for a release.
# All are optional in dev; see src/shared/deployConfig.ts.

# Where the phone companion is hosted. The TV's pairing QR code opens this URL.
VITE_PHONE_URL=https://longwashere.github.io/kettlebell-knight/phone

# Self-hosted PeerServer (npx peerjs --port 9000 --path /kk). Leave VITE_PEER_HOST empty to use the public PeerJS cloud.
VITE_PEER_HOST=
VITE_PEER_PORT=443
VITE_PEER_PATH=/kk
VITE_PEER_KEY=peerjs
VITE_PEER_SECURE=true

# TURN relay, so phones on cellular or strict routers can still reach the TV. Use ONE of:
#  a) an endpoint returning a JSON RTCIceServer[] (e.g. Metered: https://<app>.metered.live/api/v1/turn/credentials?apiKey=<key>)
VITE_ICE_SERVERS_URL=
#  b) static credentials (anyone can read these from the bundle; prefer a)
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
