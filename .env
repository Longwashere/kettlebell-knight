# Defaults for every mode (dev, preview, `npm run build` for the Fire TV app, pages). Not secret; override in .env.local
# or .env.[mode].local. The phone companion is hosted on GitHub Pages (.github/workflows/pages.yml), so the TV's pairing
# QR code points there even on the dev server.
VITE_PHONE_URL=https://longwashere.github.io/kettlebell-knight/phone
